/**
 * Kanagawa Dark theme for rofi
 * Based on Kanagawa GTK theme colors
 */

* {
    /* Kanagawa color palette */
    bg-color: #1f1f28;
    fg-color: #f2ecbc;
    bg-alt: #363646;
    fg-alt: #999da3;
    border-color: #6f894e;
    selected-bg: #7e9cd8;
    selected-fg: #f2ecbc;
    urgent-bg: #c84053;
    active-bg: #6f894e;
    
    /* Base settings */
    background-color: transparent;
    text-color: @fg-color;
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    background-color: @bg-color;
    border: 2px;
    border-color: @border-color;
    border-radius: 8px;
    width: 600px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    children: [inputbar, listview];
    spacing: 8px;
    margin: 12px;
}

inputbar {
    background-color: @bg-alt;
    text-color: @fg-color;
    border: 1px;
    border-color: @border-color;
    border-radius: 4px;
    padding: 8px 12px;
    children: [prompt, textbox-prompt-colon, entry];
}

prompt {
    background-color: transparent;
    text-color: @border-color;
    padding: 0 8px 0 0;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
    text-color: @border-color;
    background-color: transparent;
}

entry {
    background-color: transparent;
    text-color: @fg-color;
    placeholder: "Search...";
    placeholder-color: @fg-alt;
}

listview {
    background-color: transparent;
    scrollbar: false;
    spacing: 2px;
    cycle: true;
    dynamic: true;
    layout: vertical;
}

element {
    background-color: transparent;
    text-color: @fg-color;
    padding: 8px 12px;
    border-radius: 4px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element.normal.normal {
    background-color: transparent;
    text-color: @fg-color;
}

element.normal.urgent {
    background-color: @urgent-bg;
    text-color: @fg-color;
}

element.normal.active {
    background-color: @active-bg;
    text-color: @fg-color;
}

element.selected.normal {
    background-color: @selected-bg;
    text-color: @selected-fg;
}

element.selected.urgent {
    background-color: @urgent-bg;
    text-color: @fg-color;
}

element.selected.active {
    background-color: @active-bg;
    text-color: @fg-color;
}

element.alternate.normal {
    background-color: transparent;
    text-color: @fg-color;
}

element.alternate.urgent {
    background-color: @urgent-bg;
    text-color: @fg-color;
}

element.alternate.active {
    background-color: @active-bg;
    text-color: @fg-color;
}