#!/usr/bin/env python3
"""Export a Zen profile's keyboard shortcuts into the repo's declarative JSON.

    bin/zen-shortcuts-export [profile-dir] > config/zen/keyboard-shortcuts.json

WHY A FULL EXPORT AND NOT A DIFF. Zen's own `zen-keyboard-shortcuts.json` does
not record which entries you changed — a customised binding and a default one
are byte-identical in shape. There is therefore no honest way to emit "just my
overrides" from a single machine. Exporting ALL of them instead makes the file
the source of truth: every listed id is re-asserted on every `home-manager
switch`, so two machines fed this file agree completely.

The home-manager module patches BY ID and leaves unlisted ids alone, which is
why this is safe across Zen upgrades: a Zen release that adds a shortcut adds it
with its default binding, and nothing here silently deletes it. Re-run this
script after deliberately rebinding something in the UI, and `git diff` shows
exactly what you changed.

DROPPED ON PURPOSE:
  internal   Zen's own plumbing, never surfaced in the shortcut editor.
  id == null Zen ships ~12 ALTERNATE bindings with no id at all (a second key
             for zoom-reset, F5 for reload, backspace for back). The module
             patches by id, so these are unaddressable — declaring them is not
             possible, and pretending otherwise would be the lie. They keep
             whatever Zen ships.
  l10nId,
  group,
  action     display metadata; the module keys on `id` alone.

The `zen.keyboard.shortcuts.version` pref is emitted alongside so the module can
refuse to patch a schema it was not written against.
"""

import json
import os
import re
import sys
from pathlib import Path

FIELDS = ("control", "alt", "shift", "meta", "accel")


def find_profile() -> Path:
    """Resolve the profile Zen actually launches from ~/.zen/profiles.ini.

    The [InstallXXXX] section wins. `Default=1` under a [ProfileN] section is
    the OLD, per-profile-list default and on a machine that has ever run two
    builds it points somewhere stale — measured on gluck, where [Profile1]
    claims "Default Profile" while the install section names the profile with
    every extension in it.
    """
    root = Path.home() / ".zen"
    ini = root / "profiles.ini"
    if not ini.exists():
        sys.exit(f"no {ini}; pass a profile directory explicitly")

    sections, name, cur = {}, None, {}
    for line in ini.read_text().splitlines():
        line = line.strip()
        if line.startswith("["):
            if name is not None:
                sections[name] = cur
            name, cur = line.strip("[]"), {}
        elif "=" in line and name is not None:
            k, v = line.split("=", 1)
            cur[k.strip()] = v.strip()
    if name is not None:
        sections[name] = cur

    for key, sec in sections.items():
        if key.startswith("Install") and "Default" in sec:
            return root / sec["Default"]
    for key, sec in sections.items():
        if key.startswith("Profile") and sec.get("Default") == "1" and "Path" in sec:
            return root / sec["Path"]
    sys.exit(f"no default profile found in {ini}")


def shortcuts_version(profile: Path) -> int | None:
    prefs = profile / "prefs.js"
    if not prefs.exists():
        return None
    m = re.search(r'user_pref\("zen\.keyboard\.shortcuts\.version",\s*(\d+)\)', prefs.read_text())
    return int(m.group(1)) if m else None


def main() -> None:
    profile = Path(sys.argv[1]) if len(sys.argv) > 1 else find_profile()
    src = profile / "zen-keyboard-shortcuts.json"
    if not src.exists():
        sys.exit(f"{src} does not exist — launch Zen once to generate it")

    out = []
    for s in json.load(src.open())["shortcuts"]:
        if s.get("internal") or not s.get("id"):
            continue
        mods = s.get("modifiers") or {}
        out.append(
            {
                "id": s["id"],
                "key": s.get("key") or None,
                "keycode": s.get("keycode") or None,
                "modifiers": {f: bool(mods.get(f)) for f in FIELDS},
                "disabled": bool(s.get("disabled")),
            }
        )
    out.sort(key=lambda s: s["id"])

    doc = {
        "_comment": (
            f"GENERATED by bin/zen-shortcuts-export from {os.path.basename(profile)}. "
            "Edit shortcuts in Zen, re-run the script, and commit the diff."
        ),
        "version": shortcuts_version(profile),
        "shortcuts": out,
    }
    json.dump(doc, sys.stdout, indent=2)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
